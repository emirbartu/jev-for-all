{
  "name": "jev-for-all",
  "version": "0.7.1",
  "license": "MIT",
  "description": "An OpenCode plugin that routes skill and tool choices through Jev, TypeSafe's System One decision model.",
  "repository": "github:emirbartu/jev-for-all",
  "keywords": ["jev", "typesafe", "system-one", "opencode", "claude-code", "hermes", "mcp", "agent", "decisions"],
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "bin": {
    "jev-for-all": "bin/jev-for-all.js"
  },
  "files": [
    "index.ts",
    "src",
    "spec",
    "bin"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build-claude-plugin.ts"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.8",
    "@openrouter/sdk": "^1.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^5.9.0"
  }
}
